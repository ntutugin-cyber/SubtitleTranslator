<Window
    x:Class="SubtitleTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:SubtitleTranslator.ViewModels"
    Title="Переводчик субтитров"
    Width="1200"
    Height="750"
    Background="#1E1E1E"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  Тёмная тема  -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1084DE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3F3F3F" />
                                <Setter Property="Foreground" Value="#7F7F7F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3F3F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#3F3F3F" />
            <Setter Property="Foreground" Value="#0078D4" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            Margin="0,0,2,0"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8,8,0,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0078D4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#1E1E1E" />
            <Setter Property="AlternatingRowBackground" Value="#007ACC" />
        </Style>

        <Style x:Key="CustomProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border
                                Background="#333337"
                                BorderBrush="#007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle x:Name="PART_Track" />
                            </Border>
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                BorderBrush="#007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect
                                        Opacity="0.5"
                                        ShadowDepth="1"
                                        Color="#007ACC" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#007ACC" />
                        <GradientStop Offset="1" Color="#00BFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1C3F5D" />
                    <Setter Property="BorderBrush" Value="#007ACC" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#2B5177" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20" DataContext="{Binding m_rawJsonVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Foreground="#0078D4"
                Text="🎬 Переводчик субтитров" />
            <TextBlock
                Margin="0,5,0,0"
                FontSize="14"
                Foreground="#9E9E9E"
                Text="JSON → SRT с нейросетевым переводом NLLB-200" />
        </StackPanel>

        <!--  TabControl  -->
        <TabControl Grid.Row="1">
            <TabItem Header="Озвучить субтитры">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="🎬 Video VoiceOver Mixer" />

                    <StackPanel Grid.Row="1" Margin="0,4">
                        <TextBlock Margin="0,2" Text="Видеофайл (.mp4)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TxtVideo"
                                Grid.Column="0"
                                Margin="4" />
                            <Button
                                Grid.Column="1"
                                Margin="4"
                                Click="BrowseVideo_Click"
                                Content="📂" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,8">
                        <TextBlock Margin="0,2" Text="Субтитры (.srt)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TxtSrt"
                                Grid.Column="0"
                                Margin="4" />
                            <Button
                                Grid.Column="1"
                                Margin="4"
                                Click="BrowseSrt_Click"
                                Content="📂" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,8">
                        <TextBlock Margin="0,2" Text="Папка с озвучкой (.mp3)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMp3Folder" Grid.Column="0" />
                            <Button
                                Grid.Column="1"
                                Margin="4"
                                Click="BrowseFolder_Click"
                                Content="📂" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,8">
                        <TextBlock Margin="0,2" Text="Путь к ffmpeg.exe" />
                        <TextBox
                            x:Name="TxtFfmpeg"
                            Text="ffmpeg.exe"
                            ToolTip="Если в PATH, оставьте ffmpeg.exe. Иначе укажите полный путь." />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,8">
                        <TextBlock Margin="0,2" Text="Аудио без вокала (.mp3)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TxtInstrumental"
                                Grid.Column="0"
                                Margin="4" />

                            <Button
                                Grid.Column="1"
                                Margin="4"
                                Click="BrowseInstrumental_Click"
                                Content="📂" />

                            <Button
                                x:Name="BtnRemoveVocal"
                                Grid.Column="2"
                                Margin="4"
                                Click="RemoveVocal_Click"
                                Content="🎵 Удалить вокал" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="6"
                        Margin="0,8"
                        Orientation="Horizontal">
                        <CheckBox
                            x:Name="ChkUseInstrumentalOnSubtitles"
                            Content="Использовать аудио без вокала на таймлайнах субтитров"
                            IsChecked="True" />

                        <CheckBox
                            x:Name="ChkRequireGpuForVocal"
                            Margin="20,0,0,0"
                            Content="Требовать GPU"
                            IsChecked="True"
                            ToolTip="Если включено, сервер должен вернуть ошибку при отсутствии CUDA" />
                    </StackPanel>

                    <!--  ИСПРАВЛЕНО: добавлено x:Name="BtnStart"  -->
                    <Button
                        x:Name="BtnStart"
                        Grid.Row="7"
                        MinHeight="20"
                        Margin="5"
                        Click="onClickProcess"
                        Content="🚀 Начать обработку"
                        FontSize="15" />
                </Grid>
            </TabItem>

            <!--  Вкладка 1: Файловый режим  -->
            <TabItem Header="📁 Работа с файлами">
                <Grid Margin="0,10,0,0" Background="#252526">
                    <Grid.DataContext>
                        <vm:MainViewModel x:Name="FileViewModel" />
                    </Grid.DataContext>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Кнопки управления  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding LoadFileCommand}"
                            Content="📂 Загрузить из файла" />
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding LoadFromTextCommand}"
                            CommandParameter="{Binding ElementName=RawJsonTextBox, Path=Text}"
                            Content="📋 Загрузить из текста" />
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding TranslateCommand}"
                            Content="🌐 Перевести" />
                        <Button Command="{Binding SaveSrtCommand}" Content="💾 Сохранить SRT" />
                    </StackPanel>

                    <!--  Таблица субтитров  -->
                    <Border
                        Grid.Row="1"
                        Background="#252526"
                        BorderBrush="#3F3F3F"
                        BorderThickness="1"
                        CornerRadius="10">
                        <DataGrid
                            AlternatingRowBackground="#2D2D30"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            Foreground="#E0E0E0"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#3F3F3F"
                            IsReadOnly="True"
                            ItemsSource="{Binding Subtitles}"
                            RowBackground="#252526">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Speaker}"
                                    Header="#" />
                                <DataGridTextColumn Width="150" Header="Время">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0:F1} - {1:F1}">
                                            <Binding Path="Start" />
                                            <Binding Path="End" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Content}"
                                    Header="Оригинал" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding TranslatedContent}"
                                    Header="Перевод" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding DetectedLang}"
                                    Header="Язык" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!--  Вкладка 2: Работа с сырым JSON  -->
            <TabItem Header="✏️ Работа с текстом">
                <Grid Margin="0,10,0,0" Background="#252526">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Панель управления  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <!--  Опции  -->
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <CheckBox Content="🌐 Переводить на русский" IsChecked="{Binding EnableTranslation}" />
                            <CheckBox Content="👤 Указывать говорящих" IsChecked="{Binding IncludeSpeakers}" />
                            <CheckBox
                                Content="Не больше 2"
                                IsChecked="{Binding NoMoreThanTwo}"
                                ToolTip="Указывать говорящих, но их количество не больше двух" />
                            <CheckBox
                                Content="Не больше 10"
                                IsChecked="{Binding NoMoreThanTen}"
                                ToolTip="Указывать говорящих, но их количество не больше десяти" />
                            <CheckBox
                                Content="Указывать звуки"
                                IsChecked="{Binding IncludeSounds}"
                                ToolTip="Указывать посторонние звуки (музыку, звуки окружения и т. д.)" />
                            <CheckBox
                                Content="Не рус."
                                IsChecked="{Binding IsNoRus}"
                                ToolTip="Не переводить не озвучивать и не вставлять в субтитры русские фразы и блоки" />
                            <CheckBox
                                Content="Доставать голоса"
                                IsChecked="{Binding IsNeedSpeakerVoice}"
                                ToolTip="Нужно ли извлекать примеры голоса из видео и записывать их во временную папку рядом с видео с наименованиями Speaker 0, Speaker 1 и т. д." />
                        </StackPanel>

                        <!--  Кнопки  -->
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding ConvertToSubtitlesCommand}"
                                Content="📝 В субтитры (SRT)" />
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding ConvertToTextCommand}"
                                Content="📄 В текст" />
                            <Button
                                Margin="10,0,0,0"
                                Background="#D83B01"
                                Command="{Binding ClearAllCommand}"
                                Content="🗑️ Очистить" />
                        </StackPanel>
                    </StackPanel>

                    <Expander
                        Grid.Row="1"
                        Margin="5"
                        Foreground="White"
                        Header="Озвучка через Higgs TTS Studio">
                        <GroupBox Margin="5" Padding="0,5,0,0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    Text="API:" />
                                <TextBox
                                    Name="tbApiUrl"
                                    MinWidth="200"
                                    Margin="5" />
                                <TextBlock
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    Text="API Key:" />
                                <TextBox
                                    Name="tbApiKey"
                                    MinWidth="200"
                                    Margin="5" />
                                <Button
                                    Margin="5"
                                    Click="onClickCheckServer"
                                    Content="🔍 Проверить сервер" />
                                <TextBlock
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    Text="Голоса:" />
                                <ComboBox
                                    x:Name="cmbVoice"
                                    MinWidth="300"
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Value" />
                                <Button
                                    Margin="5"
                                    Click="onClickRefreshVoices"
                                    Content="Обновить список" />
                                <Button
                                    Margin="5"
                                    Click="onClickParseTelegram"
                                    Content="Расп. тг"
                                    ToolTip="Распарсить текст из телеграмма" />
                                <Button
                                    Margin="5"
                                    Click="onClickParseSub"
                                    Content="Расп. суб."
                                    ToolTip="Распарсить текст субтитров из файла *.srt" />
                                <Button
                                    Margin="5"
                                    Click="onClickSpeakTgText"
                                    Content="Озв. тг"
                                    ToolTip="Озвучить текст из телеграмма" />
                                <Button
                                    Margin="5"
                                    Click="onClickSpeakSub"
                                    Content="Озв. суб."
                                    ToolTip="Озвучить текст субтитров из файла *.srt" />
                                <Button
                                    Margin="5"
                                    Click="onClickSetVoice"
                                    Content="Уст. гол."
                                    ToolTip="Установить выбранный голос на выбранный псевдоним" />
                                <Button
                                    Margin="5"
                                    Click="onClickSpeakVideo"
                                    Content="Озв. вид."
                                    ToolTip="Озвучить видео с выбранными субтитрами и установленными голосами" />
                            </WrapPanel>
                        </GroupBox>
                    </Expander>

                    <!--  Текстовые поля  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Входной JSON  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Background="#2D2D30"
                            BorderBrush="#3F3F3F"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="15,15,15,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="📥 Входной JSON или TXT" />

                                <TextBox
                                    x:Name="RawJsonTextBox"
                                    Grid.Row="1"
                                    Margin="5"
                                    AcceptsReturn="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    Text="{Binding RawJsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <!--  Результат  -->
                        <Border
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Background="#2D2D30"
                            BorderBrush="#3F3F3F"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TabControl>
                                <TabItem Header="📤 Текстовый результат">
                                    <TextBox
                                        Name="tbResultText"
                                        Margin="5"
                                        AcceptsReturn="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        Text="{Binding ResultText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </TabItem>
                                <TabItem Header="📤 Таблица голосов">
                                    <DataGrid
                                        x:Name="dgVoices"
                                        Grid.Row="0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        ItemsSource="{Binding m_voiceItems, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="150"
                                                Binding="{Binding Name}"
                                                Header="Голос" />
                                            <DataGridTextColumn
                                                Width="150"
                                                Binding="{Binding Psevdonim}"
                                                Header="Псевдоним" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding CountLinesText}"
                                                Header="Строк" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding CountSymText}"
                                                Header="Символов" />
                                            <DataGridTextColumn
                                                Width="150"
                                                Binding="{Binding Value}"
                                                Header="Значение" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  Прогресс, статус и лог  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TxtStatus"
                Grid.Row="0"
                Margin="5"
                Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                TextWrapping="Wrap" />
            <ProgressBar
                x:Name="PbProgress"
                Grid.Row="1"
                Margin="5"
                IsIndeterminate="False"
                Maximum="100"
                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                Value="{Binding Progress}" />
            <TextBox
                x:Name="LogTextBox"
                Grid.Row="2"
                MaxHeight="150"
                Margin="5"
                AcceptsReturn="True"
                HorizontalScrollBarVisibility="Auto"
                Text="{Binding LogText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>